# Virtual Start Address of the Program | p_vaddr
00 00 40 00 00 00 00 00

# Physical Start Address of the Progarm (ignored in this case) | p_paddr
00 00 40 00 00 00 00 00

# Byte size of the Loaded Section in the file 0x123 291 | p_filesz
23 01 00 00 00 00 00 00

# Byte size of the Loaded Section in the memory 0x149 | p_memsz
49 01 00 00 00 00 00 00

# Section alignment boundary | p_align
00 00 20 00 00 00 00 00
